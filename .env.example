# PostgreSQL (lokal: siehe docker-compose.dev.yml)
DATABASE_URL=postgres://bsv:bsv_dev_pw@localhost:5432/bsv1960

# Mind. 32 Byte Zufall, z. B. `openssl rand -hex 32`. Signiert Sessions/JWTs.
PAYLOAD_SECRET=
# Öffentliche Basis-URL ohne abschließenden Slash (CORS/CSRF, Links in Mails)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Nur Dev-Server: weitere Hostnamen/IPs (kommagetrennt, ohne Port), über die er erreichbar sein darf.
# Setzt `pnpm dev:lan` selbst (Test vom Handy im Heimnetz, siehe README) – hier meist leer lassen.
# DEV_ALLOWED_ORIGINS=
# Bearer-Token für den Aufruf der Job-Queue per Cron
CRON_SECRET=
# Validiert Preview-Requests aus dem Admin
PREVIEW_SECRET=

# SMTP (lokal: Mailpit, Web-UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@bogensport-plauen.de
MAIL_FROM_NAME=BSV 1960 Plauen
# Empfänger für Formular-Benachrichtigungen (leer = öffentliche Vereinsadresse aus den Website-Einstellungen)
MAIL_NOTIFY_ADDRESS=

# Next.js-Telemetrie deaktivieren
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Nur Server (docker-compose.prod.yml, docs/betrieb.md). Lokal nicht nötig.
# Dort entfällt DATABASE_URL (setzt docker-compose.prod.yml aus POSTGRES_PASSWORD),
# NEXT_PUBLIC_SERVER_URL ist z. B. https://www.bogensport-plauen.de und SMTP_* der echte Mail-Anbieter
# (Port 587 mit STARTTLS oder 465 mit SMTP_SECURE=true).
# ---------------------------------------------------------------------------
# Datenbank-Passwort, nur hex: `openssl rand -hex 24`
POSTGRES_PASSWORD=
# Hauptadresse ohne https:// – muss zu NEXT_PUBLIC_SERVER_URL passen
SITE_DOMAIN=
# Weitere Namen, die Caddy auf SITE_DOMAIN umleitet (kommagetrennt), z. B. bogensport-plauen.de
REDIRECT_DOMAINS=
# Abnahme-Umgebung: CADDYFILE=Caddyfile.staging, dazu Passwortschutz
# (Hash: `docker run --rm caddy:2-alpine caddy hash-password`, in dieser Datei jedes $ als $$ schreiben)
CADDYFILE=Caddyfile
STAGING_USER=
STAGING_PASSWORD_HASH=
