# Konfiguration für ops/backup.sh und ops/restore.sh – auf dem Server nach /etc/bsv1960/backup.env
# kopieren (Rechte 600, Besitzer root). Anleitung: docs/backup.md

# Ziel: Hetzner Storage Box per SFTP (SSH-Schlüssel von root in ~/.ssh/config hinterlegen, siehe Doku)
RESTIC_REPOSITORY=sftp:storagebox:/backups/bsv1960
# Repository-Passwort (Datei mit Rechten 600). Ohne dieses Passwort ist die Sicherung wertlos:
# zusätzlich offline beim Vorstand aufbewahren (Passwortmanager/Tresor).
RESTIC_PASSWORD_FILE=/etc/bsv1960/restic-password

# Installation und Docker-Compose-Projekt der Website
APP_DIR=/opt/bsv1960
COMPOSE="docker compose -f /opt/bsv1960/docker-compose.prod.yml"
DB_SERVICE=db
DB_USER=bsv
DB_NAME=bsv1960

# Lokale Ablage des letzten Dumps (nur der jeweils letzte, Rechte 700)
STAGE_DIR=/var/backups/bsv1960
# Aufbewahrung (muss zur Datenschutzerklärung passen: RETENTION.backupDays in src/lib/retention.ts)
KEEP_WITHIN=30d

# Optional: Ping-URL eines Überwachungsdienstes (Start: /start, Fehler: /fail werden angehängt)
HEALTHCHECK_URL=
