# Gemeinsame Einstellungen für Produktion und Staging (per `import` eingebunden).

(logging) {
	# Zugriffslog, 14 Tage (so in der Datenschutzerklärung zugesagt). Gespeichert werden IP, Zeit,
	# Adresse, Status, Datenmenge. Nicht gespeichert: Request-/Response-Header und Einmal-Tokens aus
	# Einladungs-, Reset- und Bestätigungslinks (?token=…).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 14d
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers delete
				resp_headers delete
			}
		}
	}
}

(app) {
	encode zstd gzip

	# Größte zulässige Anfrage (Uploads im Admin); Payload prüft zusätzlich selbst
	request_body {
		max_size 25MB
	}

	# Nur übliche Methoden an die App: TRACE & Co. beantwortet Next.js mit 500 und einem
	# Stacktrace im Log (Review R21)
	@unsupportedMethod not method GET HEAD POST PUT PATCH DELETE OPTIONS
	respond @unsupportedMethod 405

	reverse_proxy app:3000 {
		# Grundlage der Rate-Limits: echte Client-IP. Überschreibt einen vom Client mitgeschickten Header.
		header_up X-Real-IP {remote_host}
	}

	# Sicherheitsheader (CSP mit Nonce, HSTS …) setzt die App – hier nichts überschreiben.
	header -Server
}
